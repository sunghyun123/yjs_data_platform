# Copy to .env and enter real values only on the machine that runs the service.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8090

# Existing ThinkWise shared index; do not point this service directly at MariaDB initially.
THINKWISE_INDEX_PATH=C:\YJS\thinkwise-wiki\data\wiki_index.db
THINKWISE_INDEX_MAX_AGE_SECONDS=180

# Synology DSM / File Station access. Use a non-admin, folder-scoped read-only account.
NAS_BASE_URL=https://192.168.0.67:5001
NAS_USERNAME=<read-only-service-account>
NAS_PASSWORD=<set-locally>
NAS_ALLOWED_SHARE=<shared-folder-name>
NAS_ALLOWED_RELATIVE_ROOT=9. 주간업무계획
NAS_TLS_VERIFY=true

# MCP remote access is allowed only through localhost/Tailscale.
MCP_BEARER_TOKEN=<generate-and-set-locally>

# AI provider settings are intentionally undecided until retrieval evaluation passes.
AI_PROVIDER=<disabled>
AI_API_KEY=<set-locally-if-enabled>
